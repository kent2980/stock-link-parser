# =============================================================================
# XBRL Parser アプリケーション設定
# =============================================================================
# このファイルを .env にコピーして、環境に合わせて値を設定してください。
# cp .env.example .env

# -----------------------------------------------------------------------------
# 基本設定
# -----------------------------------------------------------------------------
# 実行環境 (development, staging, production)
XBRL_ENVIRONMENT=development

# デバッグモード (true/false)
XBRL_DEBUG=false

# -----------------------------------------------------------------------------
# パス設定
# -----------------------------------------------------------------------------
# XBRL処理結果の出力ディレクトリ（省略時はプロジェクトルート/output）
# XBRL_OUTPUT_PATH=/path/to/output

# XBRLファイルが格納されているディレクトリ（ホスト側のパス）
# コンテナ内では /app/data にマウントされます
# デフォルト: ./data
# XBRL_DATA_DIR=./data

# XBRLファイルが格納されているディレクトリ（コンテナ内のパス）
# デフォルト: /app/data
# XBRL_XBRL_DATA_PATH=/app/data

# ログディレクトリ（省略時はプロジェクトルート/logs）
# XBRL_LOG_DIR=/path/to/logs

# ロックファイルパス（省略時はプロジェクトルート/script.lock）
# XBRL_LOCK_FILE_PATH=/path/to/script.lock

# -----------------------------------------------------------------------------
# API設定
# -----------------------------------------------------------------------------
# APIのベースURL
XBRL_API_BASE_URL=https://api.fs-stock.net

# APIタイムアウト（秒）
XBRL_API_TIMEOUT=30

# APIリトライ回数
XBRL_API_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# ログ設定
# -----------------------------------------------------------------------------
# ログレベル (DEBUG, INFO, WARNING, ERROR, CRITICAL)
XBRL_LOG_LEVEL=INFO

# コンソールへのログ出力 (true/false)
XBRL_LOG_TO_CONSOLE=true

# ファイルへのログ出力 (true/false)
XBRL_LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# 処理設定
# -----------------------------------------------------------------------------
# 並列処理の最大ワーカー数
XBRL_MAX_WORKERS=4

# バッチ処理のサイズ
XBRL_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# JPX（日本取引所グループ）設定
# -----------------------------------------------------------------------------
# 東証上場銘柄一覧のExcelファイルURL
# 注意: TSE_STOCK_LIST_URL または XBRL_TSE_STOCK_LIST_URL のどちらでも設定可能
TSE_STOCK_LIST_URL=https://www.jpx.co.jp/markets/statistics-equities/misc/tvdivq0000001vg2-att/data_j.xls

# -----------------------------------------------------------------------------
# データベース設定
# -----------------------------------------------------------------------------
# データベースホスト（コンテナ実行時はpostgres、ローカル実行時はlocalhost）
XBRL_DB_HOST=postgres

# データベースポート
XBRL_DB_PORT=5432

# データベース名
XBRL_DB_DATABASE=xbrl

# データベースユーザー名
XBRL_DB_USERNAME=postgres

# データベースパスワード
XBRL_DB_PASSWORD=postgres
